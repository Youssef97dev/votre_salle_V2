<html lang="en">

  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = { theme: { fontFamily: { 'impact': ["Impact",
      "Haettenschweiler", "Arial Narrow Bold", "sans-serif"], 'mono': ["Courier
      New", "Courier", "monospace"] }, }, };
    </script>
    <title>Facture</title>
    <style>
      body { margin: 0; padding: 0; font-family: Arial, sans-serif; }
    </style>
  </head>

  <body>
    <div class="flex flex-col gap-2 px-5">
      <div class="flex flex-row justify-between items-center text-gray-800">
        <div
          class="text-[55px]"
          style="font-family: 'Impact', 'Haettenschweiler', 'Arial Narrow Bold', 'sans-serif';"
        >FACRTURE</div>
        <img src="{{profileLogo}}" width="250" height="250" alt="" />
      </div>
      <div
        class="flex flex-row justify-between items-center text-gray-800"
        style="font-family: 'Courier New', Courier, monospace;"
      >
        <div class="flex flex-col text-[20px]">
          <span>Facture N° : {{id}}</span>
          <span>Date : {{createdAt}}</span>
        </div>
        <div class="pr-10">
          {{fullName}}
          <br />
          {{adresse}}
          <br />03200 VICHY
        </div>
      </div>
      <table class="table-fixed mt-10 text-[16px]">
        <thead>
          <tr align="left">
            <th>SALLE</th>
            <th>DATE ENTRER</th>
            <th>DATE SORTIR</th>
            <th>JOURNEES</th>
            <th>PRIX</th>
          </tr>
        </thead>
        <tbody align="left">
          <tr class="text-gray-800">
            <td class="pt-[1rem]">{{title}}</td>
            <td class="pt-[1rem]">{{startDate}}</td>
            <td class="pt-[1rem]">{{endDate}}</td>
            <td class="pt-[1rem]">{{days}}</td>
            <td class="pt-[1rem]">{{priceHT}} MAD</td>
          </tr>
          <tr>
            <td></td>
            <td></td>
            <td></td>
            <th class="pt-[3rem]">Sous Total HT</th>
            <td class="pt-[3rem] text-gray-800">{{priceHT}} MAD</td>
          </tr>
          <tr>
            <td></td>
            <td></td>
            <td></td>
            <th class="pt-[1rem]">Total TVA</th>
            <td class="text-gray-800 pt-[1rem]">{{taxPrice}} MAD</td>
          </tr>
          <tr>
            <td></td>
            <td></td>
            <td></td>
            <th class="pt-[1rem]">Total</th>
            <td class="text-gray-800 pt-[1rem]">{{price}} MAD</td>
          </tr>
        </tbody>
      </table>
      <div
        class="flex flex-row justify-between items-end mt-20 text-gray-800"
        style="font-family: 'Courier New', Courier, monospace;"
      >
        <div class="flex flex-col text-[20px]">
          <span class="font-extrabold text-[30px] mb-4">L'OBJECTIF</span>
          <span>0123456789</span>
          <span>14,AVENUE ZOLA, 75010</span>
          <span>Paris</span>
        </div>
        <div class="pr-10">
          M.DREDERIC SAMSON
          <br />
          24,RUE DESAIX,
          <br />03200 VICHY
        </div>
      </div>
    </div>
  </body>

</html>